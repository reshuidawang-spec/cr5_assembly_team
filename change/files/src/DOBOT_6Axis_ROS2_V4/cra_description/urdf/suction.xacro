<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="r2_vacuum_tool">
  <!-- R2T suction tool replica for RViz/MoveIt.
       Source dimensions come from:
       scenes/Create_Direct_Visible_EndEffectors_R1R3R5Wide_ConnectedJaw_R4fixed.lua

       CoppeliaSim mount convention:
       - R2T root is mounted on Link6 with local rpy = 0 180deg 0.
       - R2_vacuum_tip is at tool local z = -0.124 m, which maps to Link6 +Z.
  -->

  <material name="r2t_metal">
    <color rgba="0.62 0.62 0.62 1"/>
  </material>
  <material name="r2t_dark">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>
  <material name="r2t_rubber">
    <color rgba="0.02 0.02 0.02 1"/>
  </material>
  <material name="r2t_tcp">
    <color rgba="0.20 0.85 1.00 1"/>
  </material>

  <xacro:macro name="r2t_box" params="size xyz material">
    <visual>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry>
        <box size="${size}"/>
      </geometry>
      <material name="${material}"/>
    </visual>
    <collision>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry>
        <box size="${size}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="r2t_cylinder" params="radius length xyz material collision:='true'">
    <visual>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${length}"/>
      </geometry>
      <material name="${material}"/>
    </visual>
    <xacro:if value="${collision}">
      <collision>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="r2t_sphere" params="radius xyz material collision:='false'">
    <visual>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${radius}"/>
      </geometry>
      <material name="${material}"/>
    </visual>
    <xacro:if value="${collision}">
      <collision>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
      </collision>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="cr5_r2_vacuum_tool" params="parent_link:='Link6'">
    <link name="R2T">
      <inertial>
        <origin xyz="0 0 -0.06" rpy="0 0 0"/>
        <mass value="0.35"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>

      <xacro:r2t_cylinder radius="0.035" length="0.030"
        xyz="0 0 0" material="r2t_metal"/>
      <xacro:r2t_cylinder radius="0.012" length="0.070"
        xyz="0 0 -0.050" material="r2t_metal"/>
      <xacro:r2t_box size="0.150 0.090 0.012"
        xyz="0 0 -0.092" material="r2t_metal"/>

      <xacro:r2t_cylinder radius="0.016" length="0.014"
        xyz="-0.050 -0.030 -0.112" material="r2t_rubber"/>
      <xacro:r2t_cylinder radius="0.016" length="0.014"
        xyz="0.050 -0.030 -0.112" material="r2t_rubber"/>
      <xacro:r2t_cylinder radius="0.016" length="0.014"
        xyz="-0.050 0.030 -0.112" material="r2t_rubber"/>
      <xacro:r2t_cylinder radius="0.016" length="0.014"
        xyz="0.050 0.030 -0.112" material="r2t_rubber"/>

      <xacro:r2t_cylinder radius="0.004" length="0.030"
        xyz="-0.050 -0.030 -0.100" material="r2t_dark" collision="false"/>
      <xacro:r2t_cylinder radius="0.004" length="0.030"
        xyz="0.050 -0.030 -0.100" material="r2t_dark" collision="false"/>
      <xacro:r2t_cylinder radius="0.004" length="0.030"
        xyz="-0.050 0.030 -0.100" material="r2t_dark" collision="false"/>
      <xacro:r2t_cylinder radius="0.004" length="0.030"
        xyz="0.050 0.030 -0.100" material="r2t_dark" collision="false"/>
    </link>

    <joint name="R2T_mount_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 3.14159265359 0"/>
      <parent link="${parent_link}"/>
      <child link="R2T"/>
    </joint>

    <link name="R2T_tool_tcp"/>
    <joint name="R2T_tool_tcp_joint" type="fixed">
      <origin xyz="0 0 -0.124" rpy="0 0 0"/>
      <parent link="R2T"/>
      <child link="R2T_tool_tcp"/>
    </joint>

    <link name="R2T_tcp_marker">
      <xacro:r2t_sphere radius="0.008" xyz="0 0 0" material="r2t_tcp" collision="true"/>
    </link>
    <joint name="R2T_tcp_marker_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="R2T_tool_tcp"/>
      <child link="R2T_tcp_marker"/>
    </joint>

    <link name="R2_vacuum_tip"/>
    <joint name="R2_vacuum_tip_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="R2T_tool_tcp"/>
      <child link="R2_vacuum_tip"/>
    </joint>
  </xacro:macro>
</robot>
