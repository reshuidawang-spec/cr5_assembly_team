<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="r4_screwdriver_tool">
  <!-- R4T screwdriver replica for RViz/MoveIt.
       Source dimensions come from:
       scenes/Create_Direct_Visible_EndEffectors_R1R3R5Wide_ConnectedJaw_R4fixed.lua

       CoppeliaSim mount convention:
       - R4T root is mounted on Link6 with local rpy = 0 180deg 0.
       - R4_tool_tip / R4T_tool_tcp is at tool local z = -0.186 m.
  -->

  <material name="r4t_metal">
    <color rgba="0.62 0.62 0.62 1"/>
  </material>
  <material name="r4t_dark">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>
  <material name="r4t_blue">
    <color rgba="0.10 0.45 1.00 1"/>
  </material>
  <material name="r4t_tcp">
    <color rgba="1.00 0.15 0.10 1"/>
  </material>

  <xacro:macro name="r4t_box" params="size xyz material collision:='true'">
    <visual>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry>
        <box size="${size}"/>
      </geometry>
      <material name="${material}"/>
    </visual>
    <xacro:if value="${collision}">
      <collision>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <geometry>
          <box size="${size}"/>
        </geometry>
      </collision>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="r4t_cylinder" params="radius length xyz material collision:='true'">
    <visual>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${length}"/>
      </geometry>
      <material name="${material}"/>
    </visual>
    <xacro:if value="${collision}">
      <collision>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="r4t_sphere" params="radius xyz material collision:='false'">
    <visual>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${radius}"/>
      </geometry>
      <material name="${material}"/>
    </visual>
    <xacro:if value="${collision}">
      <collision>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
      </collision>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="cr5_r4_screwdriver_tool" params="parent_link:='Link6'">
    <link name="R4T">
      <inertial>
        <origin xyz="0 0 -0.06" rpy="0 0 0"/>
        <mass value="0.25"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
      </inertial>

      <xacro:r4t_cylinder radius="0.024" length="0.020"
        xyz="0 0 0" material="r4t_dark"/>
      <xacro:r4t_cylinder radius="0.016" length="0.060"
        xyz="0 0 -0.040" material="r4t_metal"/>
      <xacro:r4t_box size="0.030 0.026 0.030"
        xyz="0 0 -0.038" material="r4t_metal"/>
    </link>

    <joint name="R4T_mount_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 3.14159265359 0"/>
      <parent link="${parent_link}"/>
      <child link="R4T"/>
    </joint>

    <link name="R4T_screw_spin_link">
      <inertial>
        <origin xyz="0 0 -0.04" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>

      <xacro:r4t_cylinder radius="0.0035" length="0.075"
        xyz="0 0 -0.038" material="r4t_metal"/>
      <xacro:r4t_cylinder radius="0.0020" length="0.026"
        xyz="0 0 -0.090" material="r4t_dark"/>
      <xacro:r4t_box size="0.005 0.003 0.045"
        xyz="0.006 0 -0.038" material="r4t_blue" collision="false"/>
    </link>

    <joint name="R4T_screw_spin_joint" type="fixed">
      <origin xyz="0 0 -0.080" rpy="0 0 0"/>
      <parent link="R4T"/>
      <child link="R4T_screw_spin_link"/>
    </joint>

    <link name="R4T_tool_tcp"/>
    <joint name="R4T_tool_tcp_joint" type="fixed">
      <origin xyz="0 0 -0.106" rpy="0 0 0"/>
      <parent link="R4T_screw_spin_link"/>
      <child link="R4T_tool_tcp"/>
    </joint>

    <link name="R4T_tcp_marker">
      <xacro:r4t_sphere radius="0.007" xyz="0 0 0" material="r4t_tcp" collision="false"/>
    </link>
    <joint name="R4T_tcp_marker_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="R4T_tool_tcp"/>
      <child link="R4T_tcp_marker"/>
    </joint>

    <link name="R4_tool_tip"/>
    <joint name="R4_tool_tip_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="R4T_tool_tcp"/>
      <child link="R4_tool_tip"/>
    </joint>
  </xacro:macro>
</robot>
