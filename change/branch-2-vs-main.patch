+def _set_world_pose(
+    sim: Any,
+    handle: int,
+    position: Iterable[float],
+    orientation: Iterable[float],
+) -> None:
+    sim.setObjectPosition(handle, -1, list(position))
+    sim.setObjectOrientation(handle, -1, list(orientation))
