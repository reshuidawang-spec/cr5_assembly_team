+local function freezeAllRobots()
+    if not FREEZE_ROBOT_DYNAMICS_ON_START then return end
+
+    freezeRobot('R1')
+    freezeRobot('R2')
+    freezeRobot('R3')
+    freezeRobot('R4')
+    freezeRobot('R5')
+end
