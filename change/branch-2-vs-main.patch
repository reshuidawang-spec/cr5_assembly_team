+    "R3_MODULE_PLACE_APP": {
+        "position": [-1.105, 0.145, 0.4833],
+        "orientation_euler": [0.0, 0.0, 0.0],
+    },
+    "R3_MODULE_PLACE_TCP": {
+        "position": [-1.105, 0.145, 0.3033],
+        "orientation_euler": [0.0, 0.0, 0.0],
+    },
+    "R3_PRODUCT_PICK_APP": {
+        "position": [-1.08, 0.12, 0.432],
+        "orientation_euler": [0.0, 0.0, 0.0],
+    },
+    "R3_PRODUCT_PICK_TCP": {
+        "position": [-1.08, 0.12, 0.252],
+        "orientation_euler": [0.0, 0.0, 0.0],
+    },
