+class FakeBaseExecutor:
+    def __init__(self, bridge):
+        self.bridge = bridge
+        self.actions = []
+        self.prepare_calls = []
+
+    def prepare_cycle(
+        self,
+        quality,
+        preload_both_r5=False,
+        preposition_front_half=False,
