+
+def _angle_delta(start: float, finish: float) -> float:
+    delta = finish - start
+    while delta > math.pi:
+        delta -= 2.0 * math.pi
+    while delta < -math.pi:
+        delta += 2.0 * math.pi
+    return delta
+
