+# 场景障碍物配置 — 从 build_scene.lua 提取
+# 所有坐标已从 Lua 场景创建函数中精确推导
+# AABB 格式: {min: [x, y, z], max: [x, y, z]}
+# 所有尺寸单位为米
+
+# ================================================================
+# 地面
+# ================================================================
+ground:
+  # cuboid('Ground', {0.2, -0.35, -0.01}, {7.5, 5.2, 0.02})
+  min: [-3.55, -2.95, -0.02]
+  max: [3.95, 2.25, 0.0]
+
+# ================================================================
+# 圆形减震工作台
+# ================================================================
+tables:
+  left_damping:
+    type: cylinder
+    # cylinder('Damping_Table_Left', {-1.45, 0.45, 0.06}, 1.30, 0.12)
+    # center.z ± height/2 = 0.06 ± 0.06 → [0, 0.12]
+    center: [-1.45, 0.45, 0.06]
+    radius: 1.30
+    height: 0.12
+    aabb:
+      min: [-2.75, -0.85, 0.0]
+      max: [-0.15, 1.75, 0.12]
+    # 8 rubber pads: cylinder({x,y,0.03}, 0.07, 0.06), at r=1.05 around center
+    # 这些很小，可忽略，但因为附在桌子组下会有位移
+    rubber_pads:
+      radius: 0.07
+      height: 0.06
+      pad_z: 0.03
+      circle_radius: 1.05
+
+  right_damping:
+    type: cylinder
+    # cylinder('Damping_Table_Right', {1.20, -0.05, 0.06}, 1.30, 0.12)
+    center: [1.20, -0.05, 0.06]
+    radius: 1.30
+    height: 0.12
+    aabb:
+      min: [-0.10, -1.35, 0.0]
+      max: [2.50, 1.25, 0.12]
+
+# ================================================================
+# 功能区平台 (薄板)
+# ================================================================
+areas:
+  box_area:
+    # cuboid('Box_Area', {-2.55, 0.55, 0.15}, {0.55, 0.40, 0.04})
+    min: [-2.825, 0.35, 0.13]
+    max: [-2.275, 0.75, 0.17]
+
+  electronics_area:
+    # cuboid('Electronics_Area', {-1.10, 0.65, 0.15}, {0.60, 0.45, 0.04})
+    min: [-1.40, 0.425, 0.13]
+    max: [-0.80, 0.875, 0.17]
+
+  assembly_area:
+    # cuboid('Assembly_Area', {-0.75, -0.35, 0.15}, {0.70, 0.50, 0.04})
+    min: [-1.10, -0.60, 0.13]
+    max: [-0.40, -0.10, 0.17]
+
+  assembly_fixture:
+    # cuboid('Assembly_Fixture', {-0.75, -0.35, 0.20}, {0.52, 0.34, 0.06})
+    min: [-1.01, -0.52, 0.17]
+    max: [-0.49, -0.18, 0.23]
+
+  inspection_screw_area:
+    # cuboid('Inspection_Screw_Area', {0.45, 0.10, 0.15}, {0.75, 0.55, 0.04})
+    min: [0.075, -0.175, 0.13]
+    max: [0.825, 0.375, 0.17]
+
+  inspection_platform:
+    # cuboid('Inspection_Platform', {0.45, 0.10, 0.20}, {0.52, 0.36, 0.06})
+    min: [0.19, -0.08, 0.17]
+    max: [0.71, 0.28, 0.23]
+
+  screw_tray:
+    # cuboid('Screw_Tray', {2.05, 0.70, 0.15}, {0.42, 0.25, 0.04})
+    min: [1.84, 0.575, 0.13]
+    max: [2.26, 0.825, 0.17]
+
+  transfer_area:
+    # cuboid('Transfer_Area_Between_Tables', {-0.10, -0.12, 0.14}, {0.45, 0.35, 0.035})
+    min: [-0.325, -0.295, 0.1225]
+    max: [0.125, 0.055, 0.1575]
+
+# ================================================================
+# 开箱 (makeOpenBox: 底板 + 4壁)
+# ================================================================
+boxes:
+  # Box_Blank_1: makeOpenBox('Box_Blank_1', -2.65, 0.55, 0.17, ...)
+  # 底板: pos(-2.65, 0.55, 0.19) size(0.45,0.30,0.04) → Z: [0.17, 0.21]
