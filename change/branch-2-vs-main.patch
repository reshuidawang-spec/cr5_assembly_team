+}
+
+
+def _target_color(name: str) -> ColorRGBA:
+    if name == "R5_HOME_REF":
+        return COLORS["sort_home"]
+    if "GOOD" in name and name.endswith("_TCP"):
+        return COLORS["good_tcp"]
+    if "GOOD" in name:
+        return COLORS["good_app"]
+    if "DEFECT" in name and name.endswith("_TCP"):
