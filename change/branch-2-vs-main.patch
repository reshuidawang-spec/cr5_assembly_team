+    def __enter__(self) -> "SimBridge":
+        if not self.connect(self.host, self.port):
+            raise RuntimeError(self.last_error or "failed to connect to CoppeliaSim")
+        return self
+
+    def __exit__(self, exc_type: Any, exc: Any, traceback: Any) -> None:
+        self.disconnect()
